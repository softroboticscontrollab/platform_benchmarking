clear; clc; close all;

% Folder with saved .mat files
save_dir = 'sim_outputs';

% Define parameter sets you want to compare
param_sets = {
    'aE35_bE35_gam70'
    'aE100_bE100_gam500'
    'aE50_bE50_gam100'
    'aE32_bE32_gam60'
    'aE60_bE30_gam60'
    'aE60_bE60_gam30'
    'aE70_bE80_gam150'
    'aE50_bE30_gam1'
    'aE500_bE500_gam1000'
};

% colors = lines(length(param_sets));  % Unique colors for each run

colors = [
    0.8500, 0.3250, 0.0980;  % bright red-orange
    0.0000, 0.4470, 0.7410;  % vivid blue
    0.9290, 0.6940, 0.1250;  % golden yellow
    0.4940, 0.1840, 0.5560;  % bold purple
    0.4660, 0.6740, 0.1880;  % green
    0.3010, 0.7450, 0.9330;  % cyan-blue
    0.6350, 0.0780, 0.1840;  % dark red
    1.0000, 0.5000, 0.0000;  % orange
    0.0000, 0.6000, 0.4000;  % teal green
];


%% Create 2x2 subplot figure
hfig = figure(1); clf;

% -------- x_r subplot --------
subplot(2,2,1); hold on;
for i = 1:length(param_sets)
    id = param_sets{i};
    try
        load(fullfile(save_dir, ['x_r_' id '.mat']));
        load(fullfile(save_dir, ['time_' id '.mat']));
        plot(time, x_r, 'LineWidth', 1.5, 'Color', colors(i,:), ...
            'DisplayName', strrep(id, '_', ', '));
    catch
        warning('Missing x_r data for %s — skipping.', id);
    end
end
xlabel('Time [s]');
ylabel('$x_r$ [m]', 'Interpreter', 'latex');
title('End-Effector $x_r$', 'Interpreter', 'latex');
 grid on;
 % legend('show');

% -------- y_r subplot --------
subplot(2,2,2); hold on;
for i = 1:length(param_sets)
    id = param_sets{i};
    try
        load(fullfile(save_dir, ['y_r_' id '.mat']));
        load(fullfile(save_dir, ['time_' id '.mat']));
        plot(time, y_r, 'LineWidth', 1.5, 'Color', colors(i,:), ...
            'DisplayName', strrep(id, '_', ', '));
    catch
        warning('Missing y_r data for %s — skipping.', id);
    end
end
xlabel('Time [s]');
ylabel('$y_r$ [m]', 'Interpreter', 'latex');
title('End-Effector $y_r$', 'Interpreter', 'latex');
 grid on;

% -------- u_1 subplot --------
subplot(2,2,3); hold on;
for i = 1:length(param_sets)
    id = param_sets{i};
    try
        load(fullfile(save_dir, ['u_t_' id '.mat']));
        load(fullfile(save_dir, ['time_' id '.mat']));
        time_u = time(1:end-1);
        plot(time_u, u_t(1,:), 'LineWidth', 1.5, 'Color', colors(i,:), ...
            'DisplayName', strrep(id, '_', ', '));
    catch
        warning('Missing u_1 data for %s — skipping.', id);
    end
end
xlabel('Time [s]');
ylabel('$u_1$ [Pa]', 'Interpreter', 'latex');
title('Control Input $u_1$', 'Interpreter', 'latex');
 grid on;

% -------- u_2 subplot --------
subplot(2,2,4); hold on;
for i = 1:length(param_sets)
    id = param_sets{i};
    try
        load(fullfile(save_dir, ['u_t_' id '.mat']));
        load(fullfile(save_dir, ['time_' id '.mat']));
        time_u = time(1:end-1);
        plot(time_u, u_t(2,:), 'LineWidth', 1.5, 'Color', colors(i,:), ...
            'DisplayName', strrep(id, '_', ', '));
    catch
        warning('Missing u_2 data for %s — skipping.', id);
    end
end
xlabel('Time [s]');
ylabel('$u_2$ [Pa]', 'Interpreter', 'latex');
title('Control Input $u_2$', 'Interpreter', 'latex');
grid on;

%% Styling & Export
font_size = 11;
single_column = true;
picturewidth_singlecolumn = 8.6;  % cm
picturewidth_doublecolumn = 17.8; % cm
hw_ratio = 0.9;
fname = 'cbf_simulation_comparison';

set(findall(hfig,'-property','FontSize'), 'FontSize', font_size)
set(findall(hfig,'-property','Box'), 'Box', 'off')
set(findall(hfig,'-property','Interpreter'), 'Interpreter', 'latex')
set(findall(hfig,'-property','TickLabelInterpreter'), 'TickLabelInterpreter', 'latex')

if single_column
    set(hfig, 'Units', 'centimeters', ...
        'Position', [3 3 picturewidth_singlecolumn hw_ratio * picturewidth_singlecolumn]);
else
    set(hfig, 'Units', 'centimeters', ...
        'Position', [3 3 picturewidth_doublecolumn hw_ratio * picturewidth_doublecolumn]);
end
pos = get(hfig, 'Position');
set(hfig, 'PaperPositionMode', 'Auto', ...
    'PaperUnits', 'centimeters', ...
    'PaperSize', [pos(3), pos(4)]);

exportgraphics(hfig, strcat(fname, '.pdf'), 'ContentType', 'vector');
exportgraphics(hfig, strcat(fname, '.png'), 'ContentType', 'vector');

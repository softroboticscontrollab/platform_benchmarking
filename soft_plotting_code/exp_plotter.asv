%% Plotting Code used for plotting of data in Paper
clear all; close all; clc;

%% Setup
% values here are chosen based on physical hardware

% length of limb 1
l1 = 0.122; 
% length of limb 2
l2 = 0.122; 
epsilon = 1e-6; 
% calculated spring constant of deformable force plate   
k = 11.16; 
% allowable max force on force plate - used for force-critical tasks
Fmax = 11.16 * 1.6 / 100; 

%% Reference Trajectory 

RTJ = 'plotting_data/sinwave_traj.csv';

RTJ = readtable(RTJ, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');

time_RTJ     = RTJ.("Test time");
time_RTJ     = time_RTJ(2:end);
theta_0_RTJ  = RTJ.theta_0;
theta_0_RTJ  = theta_0_RTJ(2:end);
theta_1_RTJ  = RTJ.theta_1;
theta_1_RTJ  = theta_1_RTJ(2:end);

u_RTJ        = RTJ.("u_t(0)");

startidx_RTJ = find(RTJ.("u_t(0)"), 1, 'first');

endidx_RTJ   = find(RTJ.("u_t(0)"), 1, 'last');

last_time = endidx_RTJ - startidx_RTJ;

time_RTJ = time_RTJ - time_RTJ(startidx_RTJ);

% Convert angles from degrees to radians
q0_RTJ  = deg2rad(theta_0_RTJ*2);
q1_RTJ  = deg2rad(theta_1_RTJ*2);

%% Range values of q = [q0,q1] for PD w/o force plate

updwo1 = 'exp_data/upd_wo1_v2';
updwo2 = 'exp_data/upd_wo2_v2';
updwo3 = 'exp_data/upd_wo3_v2';
updwo4 = 'exp_data/upd_wo4_v2';
updwo5 = 'exp_data/upd_wo5_v2';

updwo1 = readtable(updwo1, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');
updwo2 = readtable(updwo2, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');
updwo3 = readtable(updwo3, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');
updwo4 = readtable(updwo4, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');
updwo5 = readtable(updwo5, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');

time_updwo1     = updwo1.("Test time");
time_updwo2     = updwo2.("Test time");
time_updwo3     = updwo3.("Test time");
time_updwo4     = updwo4.("Test time");
time_updwo5     = updwo5.("Test time");

q0_updwo1 = deg2rad(updwo1.theta_0*2);
q1_updwo1 = deg2rad(updwo1.theta_1*2);
q0_updwo2 = deg2rad(updwo2.theta_0*2);
q1_updwo2 = deg2rad(updwo2.theta_1*2);
q0_updwo3 = deg2rad(updwo3.theta_0*2);
q1_updwo3 = deg2rad(updwo3.theta_1*2);
q0_updwo4 = deg2rad(updwo4.theta_0*2);
q1_updwo4 = deg2rad(updwo4.theta_1*2);
q0_updwo5 = deg2rad(updwo5.theta_0*2);
q1_updwo5 = deg2rad(updwo5.theta_1*2);

start_idx1 = find(updwo1.("u_t(0)"), 1, 'first') + startidx_RTJ;
start_idx2 = find(updwo2.("u_t(0)"), 1, 'first') + startidx_RTJ; 
start_idx3 = find(updwo3.("u_t(0)"), 1, 'first') + startidx_RTJ;
start_idx4 = find(updwo4.("u_t(0)"), 1, 'first') + startidx_RTJ;
start_idx5 = find(updwo5.("u_t(0)"), 1, 'first') + startidx_RTJ;

end_idx1 = start_idx1 + last_time;
end_idx2 = start_idx2 + last_time;
end_idx3 = start_idx3 + last_time;
end_idx4 = start_idx4 + last_time;
end_idx5 = start_idx5 + last_time;

time_updwo1     = time_updwo1 - time_updwo1(start_idx1);
time_updwo2     = time_updwo2 - time_updwo2(start_idx2);
time_updwo3     = time_updwo3 - time_updwo3(start_idx3);
time_updwo4     = time_updwo4 - time_updwo4(start_idx4);
time_updwo5     = time_updwo5 - time_updwo5(start_idx5);

q0_updwo1 = q0_updwo1(start_idx1:end_idx1);
q1_updwo1 = q1_updwo1(start_idx1:end_idx1);
q0_updwo2 = q0_updwo2(start_idx2:end_idx2);
q1_updwo2 = q1_updwo2(start_idx2:end_idx2);
q0_updwo3 = q0_updwo3(start_idx3:end_idx3);
q1_updwo3 = q1_updwo3(start_idx3:end_idx3);
q0_updwo4 = q0_updwo4(start_idx4:end_idx4);
q1_updwo4 = q1_updwo4(start_idx4:end_idx4);
q0_updwo5 = q0_updwo5(start_idx5:end_idx5);
q1_updwo5 = q1_updwo5(start_idx5:end_idx5);

q0_updwo_all = [q0_updwo1,q0_updwo2,q0_updwo3,q0_updwo4,q0_updwo5];
mu = mean(q0_updwo_all,2);
sigma = std(q0_updwo_all,0,2);
q0_updwo_upper = mu + 2*sigma;
q0_updwo_lower = mu - 2*sigma;
q0_updwo_mean = mu;

q1_updwo_all = [q1_updwo1,q1_updwo2,q1_updwo3,q1_updwo4,q1_updwo5];
mu = mean(q1_updwo_all,2);
sigma = std(q1_updwo_all,0,2);
q1_updwo_upper = mu + 2*sigma;
q1_updwo_lower = mu - 2*sigma;
q1_updwo_mean = mu;

% q0

Plot1 = figure(1);
subplot(2,1,1);

x_fill = time_updwo1(start_idx1:end_idx1);
y_upper = q0_updwo_upper(:);
y_lower = q0_updwo_lower(:);

fill([x_fill; flipud(x_fill)], ...
     [y_upper; flipud(y_lower)], ...
     [0 0.604 0.192], 'EdgeColor', 'none','FaceAlpha', 0.2);
hold on 

p1 = plot(time_RTJ(startidx_RTJ:end),q0_RTJ(startidx_RTJ:end),LineWidth=2,Color=[0.25 0.25 0.25]);
p2 = plot(time_RTJ(startidx_RTJ:end),q0_updwo_mean(2:end),LineWidth=1,Color=[0 0.604 0.192]);

lgd = legend([p1 p2],{'Reference Trajectory','Achieved Trajectory'},Location='northeast');    
lgd.FontSize = 15;

ylabel('q_0 (radians)','FontSize',14) 
% xlabel('Time (s)','FontSize',14) 

title('Tracking with PD w/o Force Plate')

hold off 

% q1 

subplot(2,1,2);

x_fill = time_updwo1(start_idx1:end_idx1);
y_upper = q1_updwo_upper(:);
y_lower = q1_updwo_lower(:);

fill([x_fill; flipud(x_fill)], ...
     [y_upper; flipud(y_lower)], ...
     [0.188 0.361 0.92], 'EdgeColor', 'none','FaceAlpha', 0.2);
hold on 

p1 = plot(time_RTJ(startidx_RTJ:end),q1_RTJ(startidx_RTJ:end),LineWidth=2,Color=[0.25 0.25 0.25]);
p2 = plot(time_RTJ(startidx_RTJ:end),q1_updwo_mean(2:end),LineWidth=1,Color=[0.188 0.361 0.92]);

lgd = legend([p1 p2],{'Reference Trajectory','Achieved Trajectory'},Location='northeast');    
lgd.FontSize = 15;

ylabel('q_1 (radians)','FontSize',14) 
xlabel('Time (s)','FontSize',14) 

% title('Tracking with PD+')

hold off 


%% Range values of q = [q0,q1] for PD w force plate



%% Range values of q = [q0,q1] for CD w/o force plate

ucdwo1 = 'exp_data/ucd_wo1';
ucdwo2 = 'exp_data/ucd_wo2';
ucdwo3 = 'exp_data/ucd_wo3';
ucdwo4 = 'exp_data/ucd_wo4';
ucdwo5 = 'exp_data/ucd_wo5';

ucdwo1 = readtable(ucdwo1, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');
ucdwo2 = readtable(ucdwo2, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');
ucdwo3 = readtable(ucdwo3, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');
ucdwo4 = readtable(ucdwo4, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');
ucdwo5 = readtable(ucdwo5, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');

time_ucdwo1     = ucdwo1.("Test time");
time_ucdwo2     = ucdwo2.("Test time");
time_ucdwo3     = ucdwo3.("Test time");
time_ucdwo4     = ucdwo4.("Test time");
time_ucdwo5     = ucdwo5.("Test time");

q0_ucdwo1 = deg2rad(ucdwo1.theta_0*2);
q1_ucdwo1 = deg2rad(ucdwo1.theta_1*2);
q0_ucdwo2 = deg2rad(ucdwo2.theta_0*2);
q1_ucdwo2 = deg2rad(ucdwo2.theta_1*2);
q0_ucdwo3 = deg2rad(ucdwo3.theta_0*2);
q1_ucdwo3 = deg2rad(ucdwo3.theta_1*2);
q0_ucdwo4 = deg2rad(ucdwo4.theta_0*2);
q1_ucdwo4 = deg2rad(ucdwo4.theta_1*2);
q0_ucdwo5 = deg2rad(ucdwo5.theta_0*2);
q1_ucdwo5 = deg2rad(ucdwo5.theta_1*2);

start_idx1 = find(ucdwo1.("u_t(0)"), 1, 'first') + startidx_RTJ;
start_idx2 = find(ucdwo2.("u_t(0)"), 1, 'first') + startidx_RTJ; 
start_idx3 = find(ucdwo3.("u_t(0)"), 1, 'first') + startidx_RTJ;
start_idx4 = find(ucdwo4.("u_t(0)"), 1, 'first') + startidx_RTJ;
start_idx5 = find(ucdwo5.("u_t(0)"), 1, 'first') + startidx_RTJ;

end_idx1 = start_idx1 + last_time;
end_idx2 = start_idx2 + last_time;
end_idx3 = start_idx3 + last_time;
end_idx4 = start_idx4 + last_time;
end_idx5 = start_idx5 + last_time;

time_ucdwo1     = time_ucdwo1 - time_ucdwo1(start_idx1);
time_ucdwo2     = time_ucdwo2 - time_ucdwo2(start_idx2);
time_ucdwo3     = time_ucdwo3 - time_ucdwo3(start_idx3);
time_ucdwo4     = time_ucdwo4 - time_ucdwo4(start_idx4);
time_ucdwo5     = time_ucdwo5 - time_ucdwo5(start_idx5);

q0_ucdwo1 = q0_ucdwo1(start_idx1:end_idx1);
q1_ucdwo1 = q1_ucdwo1(start_idx1:end_idx1);
q0_ucdwo2 = q0_ucdwo2(start_idx2:end_idx2);
q1_ucdwo2 = q1_ucdwo2(start_idx2:end_idx2);
q0_ucdwo3 = q0_ucdwo3(start_idx3:end_idx3);
q1_ucdwo3 = q1_ucdwo3(start_idx3:end_idx3);
q0_ucdwo4 = q0_ucdwo4(start_idx4:end_idx4);
q1_ucdwo4 = q1_ucdwo4(start_idx4:end_idx4);
q0_ucdwo5 = q0_ucdwo5(start_idx5:end_idx5);
q1_ucdwo5 = q1_ucdwo5(start_idx5:end_idx5);

q0_ucdwo_all = [q0_ucdwo1,q0_ucdwo2,q0_ucdwo3,q0_ucdwo4,q0_ucdwo5];
mu = mean(q0_ucdwo_all,2);
sigma = std(q0_ucdwo_all,0,2);
q0_ucdwo_upper = mu + 2*sigma;
q0_ucdwo_lower = mu - 2*sigma;
q0_ucdwo_mean = mu;

q1_ucdwo_all = [q1_ucdwo1,q1_ucdwo2,q1_ucdwo3,q1_ucdwo4,q1_ucdwo5];
mu = mean(q1_ucdwo_all,2);
sigma = std(q1_ucdwo_all,0,2);
q1_ucdwo_upper = mu + 2*sigma;
q1_ucdwo_lower = mu - 2*sigma;
q1_ucdwo_mean = mu;

% q0

Plot1 = figure(2);
subplot(2,1,1);

x_fill = time_ucdwo1(start_idx1:end_idx1);
y_upper = q0_ucdwo_upper(:);
y_lower = q0_ucdwo_lower(:);

fill([x_fill; flipud(x_fill)], ...
     [y_upper; flipud(y_lower)], ...
     [0 0.604 0.192], 'EdgeColor', 'none','FaceAlpha', 0.2);
hold on 

p1 = plot(time_RTJ(startidx_RTJ:end),q0_RTJ(startidx_RTJ:end),LineWidth=2,Color=[0.25 0.25 0.25]);
p2 = plot(time_RTJ(startidx_RTJ:end),q0_ucdwo_mean(2:end),LineWidth=1,Color=[0 0.604 0.192]);

lgd = legend([p1 p2],{'Reference Trajectory','Achieved Trajectory'},Location='northeast');    
lgd.FontSize = 15;

ylabel('q_0 (radians)','FontSize',14) 
% xlabel('Time (s)','FontSize',14) 

title('Tracking with ID w/o Force Plate')

hold off 

% q1 

subplot(2,1,2);

x_fill = time_ucdwo1(start_idx1:end_idx1);
y_upper = q1_ucdwo_upper(:);
y_lower = q1_ucdwo_lower(:);

fill([x_fill; flipud(x_fill)], ...
     [y_upper; flipud(y_lower)], ...
     [0.188 0.361 0.92], 'EdgeColor', 'none','FaceAlpha', 0.2);
hold on 

p1 = plot(time_RTJ(startidx_RTJ:end),q1_RTJ(startidx_RTJ:end),LineWidth=2,Color=[0.25 0.25 0.25]);
p2 = plot(time_RTJ(startidx_RTJ:end),q1_ucdwo_mean(2:end),LineWidth=1,Color=[0.188 0.361 0.92]);

lgd = legend([p1 p2],{'Reference Trajectory','Achieved Trajectory'},Location='northeast');    
lgd.FontSize = 15;

ylabel('q_1 (radians)','FontSize',14) 
xlabel('Time (s)','FontSize',14) 

% title('Tracking with PD+')

hold off 


%% Range values of q = [q0,q1] for ID w force plate

ucdw1 = 'exp_data/ucd_w1'; % setting files to pull data from
ucdw2 = 'exp_data/ucd_w2';
ucdw3 = 'exp_data/ucd_w3';
ucdw4 = 'exp_data/ucd_w4';
ucdw5 = 'exp_data/ucd_w5';

ucdw1 = readtable(ucdw1, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve'); % pulling data
ucdw2 = readtable(ucdw2, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');
ucdw3 = readtable(ucdw3, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');
ucdw4 = readtable(ucdw4, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');
ucdw5 = readtable(ucdw5, ...
    'HeaderLines', 2, 'VariableNamingRule', 'preserve');

time_ucdw1     = ucdw1.("Test time"); % pulling out time data
time_ucdw2     = ucdw2.("Test time");
time_ucdw3     = ucdw3.("Test time");
time_ucdw4     = ucdw4.("Test time");
time_ucdw5     = ucdw5.("Test time");

force1_ucdw1   = ucdw1.("ForcePlate_0"); % pulling out force data 
force1_ucdw2   = ucdw2.("ForcePlate_0");
force1_ucdw3   = ucdw3.("ForcePlate_0");
force1_ucdw4   = ucdw4.("ForcePlate_0");
force1_ucdw5   = ucdw5.("ForcePlate_0");

force1_ucdw1   = force1_ucdw1/1000*9.8; % changing grams to newtons
force1_ucdw2   = force1_ucdw2/1000*9.8;
force1_ucdw3   = force1_ucdw3/1000*9.8;
force1_ucdw4   = force1_ucdw4/1000*9.8;
force1_ucdw5   = force1_ucdw5/1000*9.8;

rho_ucdw1 = (Fmax - force1_ucdw1)/Fmax;
rho_ucdw2 = (Fmax - force1_ucdw2)/Fmax;
rho_ucdw3 = (Fmax - force1_ucdw3)/Fmax;
rho_ucdw4 = (Fmax - force1_ucdw4)/Fmax;
rho_ucdw5 = (Fmax - force1_ucdw5)/Fmax;

q0_ucdw1 = deg2rad(ucdw1.theta_0*2);
q1_ucdw1 = deg2rad(ucdw1.theta_1*2);
q0_ucdw2 = deg2rad(ucdw2.theta_0*2);
q1_ucdw2 = deg2rad(ucdw2.theta_1*2);
q0_ucdw3 = deg2rad(ucdw3.theta_0*2);
q1_ucdw3 = deg2rad(ucdw3.theta_1*2);
q0_ucdw4 = deg2rad(ucdw4.theta_0*2);
q1_ucdw4 = deg2rad(ucdw4.theta_1*2);
q0_ucdw5 = deg2rad(ucdw5.theta_0*2);
q1_ucdw5 = deg2rad(ucdw5.theta_1*2);

start_idx1 = find(ucdw1.("u_t(0)"), 1, 'first') + startidx_RTJ;
start_idx2 = find(ucdw2.("u_t(0)"), 1, 'first') + startidx_RTJ; 
start_idx3 = find(ucdw3.("u_t(0)"), 1, 'first') + startidx_RTJ;
start_idx4 = find(ucdw4.("u_t(0)"), 1, 'first') + startidx_RTJ;
start_idx5 = find(ucdw5.("u_t(0)"), 1, 'first') + startidx_RTJ;

end_idx1 = start_idx1 + last_time;
end_idx2 = start_idx2 + last_time;
end_idx3 = start_idx3 + last_time;
end_idx4 = start_idx4 + last_time;
end_idx5 = start_idx5 + last_time;

time_ucdw1     = time_ucdw1 - time_ucdw1(start_idx1);
time_ucdw2     = time_ucdw2 - time_ucdw2(start_idx2);
time_ucdw3     = time_ucdw3 - time_ucdw3(start_idx3);
time_ucdw4     = time_ucdw4 - time_ucdw4(start_idx4);
time_ucdw5     = time_ucdw5 - time_ucdw5(start_idx5);

q0_ucdw1 = q0_ucdw1(start_idx1:end_idx1);
q1_ucdw1 = q1_ucdw1(start_idx1:end_idx1);
q0_ucdw2 = q0_ucdw2(start_idx2:end_idx2);
q1_ucdw2 = q1_ucdw2(start_idx2:end_idx2);
q0_ucdw3 = q0_ucdw3(start_idx3:end_idx3);
q1_ucdw3 = q1_ucdw3(start_idx3:end_idx3);
q0_ucdw4 = q0_ucdw4(start_idx4:end_idx4);
q1_ucdw4 = q1_ucdw4(start_idx4:end_idx4);
q0_ucdw5 = q0_ucdw5(start_idx5:end_idx5);
q1_ucdw5 = q1_ucdw5(start_idx5:end_idx5);

q0_ucdw_all = [q0_ucdw1,q0_ucdw2,q0_ucdw3,q0_ucdw4,q0_ucdw5];
mu = mean(q0_ucdw_all,2);
sigma = std(q0_ucdw_all,0,2);
q0_ucdw_upper = mu + 2*sigma;
q0_ucdw_lower = mu - 2*sigma;
q0_ucdw_mean = mu;

q1_ucdw_all = [q1_ucdw1,q1_ucdw2,q1_ucdw3,q1_ucdw4,q1_ucdw5];
mu = mean(q1_ucdw_all,2);
sigma = std(q1_ucdw_all,0,2);
q1_ucdw_upper = mu + 2*sigma;
q1_ucdw_lower = mu - 2*sigma;
q1_ucdw_mean = mu;

rho_ucdw_all = [rho_ucdw1,rho_ucdw2,rho_ucdw3,rho_ucdw4,rho_ucdw5];
mu = mean(rho_ucdw_all,2);
sigma = std(rho_ucdw_all,0,2);
rho_ucdw_upper = mu + 2*sigma;
rho_ucdw_lower = mu - 2*sigma;
rho_ucdw_mean = mu;

rho_max = zeros(length(time_RTJ(startidx_RTJ:end)),1);

% q0

Plot1 = figure(3);
subplot(2,1,1);

x_fill = time_ucdw1(start_idx1:end_idx1);
y_upper = q0_ucdw_upper(:);
y_lower = q0_ucdw_lower(:);

fill([x_fill; flipud(x_fill)], ...
     [y_upper; flipud(y_lower)], ...
     [0 0.604 0.192], 'EdgeColor', 'none','FaceAlpha', 0.2);
hold on 

p1 = plot(time_RTJ(startidx_RTJ:end),q0_RTJ(startidx_RTJ:end),LineWidth=2,Color=[0.25 0.25 0.25]);
p2 = plot(time_RTJ(startidx_RTJ:end),q0_ucdw_mean(2:end),LineWidth=1,Color=[0 0.604 0.192]);

lgd = legend([p1 p2],{'Reference Trajectory','Achieved Trajectory'},Location='northeast');    
lgd.FontSize = 15;

ylabel('q_0 (radians)','FontSize',14) 
% xlabel('Time (s)','FontSize',14) 

title('Tracking with ID with Force Plate')

hold off 

% q1 

subplot(2,1,2);

x_fill = time_ucdw1(start_idx1:end_idx1);
y_upper = q1_ucdw_upper(:);
y_lower = q1_ucdw_lower(:);

fill([x_fill; flipud(x_fill)], ...
     [y_upper; flipud(y_lower)], ...
     [0.188 0.361 0.92], 'EdgeColor', 'none','FaceAlpha', 0.2);
hold on 

p1 = plot(time_RTJ(startidx_RTJ:end),q1_RTJ(startidx_RTJ:end),LineWidth=2,Color=[0.25 0.25 0.25]);
p2 = plot(time_RTJ(startidx_RTJ:end),q1_ucdw_mean(2:end),LineWidth=1,Color=[0.188 0.361 0.92]);

lgd = legend([p1 p2],{'Reference Trajectory','Achieved Trajectory'},Location='northeast');    
lgd.FontSize = 15;

ylabel('q_1 (radians)','FontSize',14) 
xlabel('Time (s)','FontSize',14) 

hold off 

Plot2 = figure(4);

x_fill = time_ucdw1(start_idx1:end_idx1);
y_upper = rho_ucdw_upper(:);
y_lower = rho_ucdw_lower(:);

fill([x_fill; flipud(x_fill)], ...
     [y_upper; flipud(y_lower)], ...
     [0 0.604 0.192], 'EdgeColor', 'none','FaceAlpha', 0.2);
hold on 

p1 = plot(time_RTJ(startidx_RTJ:end),rho_max,LineWidth=2,Color='red',LineStyle="--");
p2 = plot(time_RTJ(startidx_RTJ:end),rho_ucdw_mean(2:end),LineWidth=1,Color=[0 0.604 0.192]);

lgd = legend([p1 p2],{'Maximum','Achieved Trajectory'},Location='northeast');    
lgd.FontSize = 15;

ylabel('q_0 (radians)','FontSize',14) 
% xlabel('Time (s)','FontSize',14) 

title('Tracking with ID with Force Plate')

hold off 

% (C) Soft Robotics Control Lab, Boston University, 2024-

clear all; close all; clc;

% Add paths (modify if needed)
basedir = '..';
addpath(genpath(basedir));
rmpath(genpath(strcat(basedir, '\.git')));
addpath(genpath('../../helpers'));
addpath(genpath('../../plotting_soft'));
addpath(genpath('../../polyhedron_constraints'));

disp('Running simulation with PID Controller...');

%% Simulation parameters
tmax = 20; dt = 0.00001;

n = round(tmax/dt);

% Dynamics parameters
m2 = 0.13; m6 = 0.13;
k1 = 147.55762; k2 = 253.56177;
damping = 5.0; 
l1 = 0.122; l2 = 0.122;
g = 9.81; tol = 1e4;
F_max = 0.16; k_env = 11.16;
aE = 0.2; bE = 0.2; gam = 0.2;  
p_des = [deg2rad(20); deg2rad( )];  
Kp = [10;10]; Kd = [1;1];  


c.m2 = m2; c.m6 = m6; c.damping = damping;
c.k1 = k1; c.k2 = k2; c.g = g; c.tol = tol;
c.l1 = l1; c.l2 = l2; c.k_env = k_env;
c.F_max = F_max; c.aE = aE; c.bE = bE; c.gam = gam;
c.p_des = p_des; c.Kp = Kp; c.Kd = Kd; 


%% Initial conditions
theta1_0 = 0.01; 
theta2_0 = 0.01;
dottheta1_0 = 0; dottheta2_0 = 0;
x0 = [theta1_0; theta2_0; dottheta1_0; dottheta2_0];
x_traj = zeros(4, n+1); x_traj(:,1) = x0;

lambda = diag([1.0, 1.0]);
t_vec_sim = 0:dt:tmax;

%% Initialize control input
u_t = [0; 0];
u_traj = zeros(2, n); 
% q_des = [deg2rad(30); deg2rad(30)];   
% p_des = [0.2; 0.15];  

% %% PID gains 
% c.Kp = diag([100, 100]);    
% c.Ki = diag([10, 10]);  
% c.Kd = diag([10, 10]); 


%% Simulate
times = zeros(1, n);
disp('Simulation time (seconds):')
for k = 1:n
    
    if mod(k, 1/dt) == 0
        disp(string(k*dt));
    end

    t = (k-1)*dt; 

    % u_t = u_pid_control(x_traj(1:2,t), x_traj(3:4,t), q_des, dt, c);
    u_t = u_pid_control(x_traj(:,k), c, t);

    u_traj(:, k) = u_t;
    [~, bolddotx_t] = dynamics_soft(x_traj(:,k), c, u_t);
    x_traj(:,k+1) = x_traj(:,k) + dt * bolddotx_t;

    if any(abs(x_traj(:,k+1)) > tol)
        warning("Simulation unstable at t = %.4f sec", k*dt);
        x_traj = x_traj(:,1:k);
        break;
    end
end

% disp(u_traj)
% avg_time = mean(times);
% disp(avg_time)

%% Downsample for plotting at 100 Hz
plot_freq = 10;                  % Hz
plot_dt = 1 / plot_freq;          % seconds between plot points
plot_interval = round(plot_dt / dt);  % number of simulation steps to skip

plot_indices = 1:plot_interval:length(t_vec_sim);
plot_indices = plot_indices(plot_indices <= size(u_traj, 2));

q1 = x_traj(1, plot_indices);
q2 = x_traj(2, plot_indices);

epsilon = 1e-6;
q1_safe = q1; q2_safe = q2;
q1_safe(q1 == 0) = epsilon;
q2_safe(q2 == 0) = epsilon;

x_r = c.l2 * ((cos(q1) .* sin(q2) + sin(q1) .* cos(q2) - sin(q1)) ./ q2_safe) ...
    + c.l1 * (sin(q1) ./ q1_safe);

y_r = c.l2 * ((sin(q1) .* sin(q2) - cos(q1) .* cos(q2) + cos(q1)) ./ q2_safe) ...
    + c.l1 * ((1 - cos(q1)) ./ q1_safe);

u1 = u_traj(1, plot_indices);
u2 = u_traj(2, plot_indices);

time = t_vec_sim(plot_indices);
%% Compute barrier (for plotting)

V = [0.35, 0.0322;
     0, 0.159627;
     0,  -0.1963;
     0.35, 0.00577];

[H, h] = computeSafetyConstraints(V);

%% Plot
Soft_CBF_plotting(x_traj(1 :2, :), [l1, l2], H, h, F_max, k_env, dt);

